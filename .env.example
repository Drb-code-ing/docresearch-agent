# Export these variables in your shell; this file is not loaded automatically.
DOCRESEARCH_BASE_URL=https://api.example.com/v1
DOCRESEARCH_API_KEY=
DOCRESEARCH_MODEL=
# Required for the default ES/Milvus backend. Optional for explicit --backend memory.
DOCRESEARCH_EMBEDDING_MODEL=
# Optional pair: a different provider for embeddings. Leave BOTH empty to share chat config.
DOCRESEARCH_EMBEDDING_BASE_URL=
DOCRESEARCH_EMBEDDING_API_KEY=
# false bypasses environment/system proxies and environment certificate settings.
# TLS verification remains enabled. Default true follows HTTPX environment behavior.
DOCRESEARCH_TRUST_ENV=true
# Persistent retrieval, the default for `docresearch run`. Ingest the corpus first.
DOCRESEARCH_ES_URL=http://localhost:9200
DOCRESEARCH_MILVUS_URI=http://localhost:19530
DOCRESEARCH_NAMESPACE=docs
DOCRESEARCH_ES_ANALYZER=ik_max_word
DOCRESEARCH_ES_SEARCH_ANALYZER=ik_smart
DOCRESEARCH_ES_API_KEY=
DOCRESEARCH_MILVUS_TOKEN=
# Bump if a provider changes embedding weights behind the same model name.
DOCRESEARCH_EMBEDDING_REVISION=1
# Optional dedicated reranker. Set all three together; otherwise use explicit LLM grading/ranking.
DOCRESEARCH_RERANK_URL=
DOCRESEARCH_RERANK_API_KEY=
DOCRESEARCH_RERANK_MODEL=
